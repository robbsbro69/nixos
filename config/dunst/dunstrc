[global]
### Display ###
monitor = 0
follow = mouse
origin = top-right
offset = (20, 20)
width = 340
height = (0, 300)
scale = 0
notification_limit = 5

### Appearance ###
transparency = 10
corner_radius = 12
frame_width = 2
gap_size = 10
separator_height = 2
padding = 14
horizontal_padding = 14
text_icon_padding = 12

### Text ###
font = JetBrainsMono Nerd Font 10
line_height = 4
markup = full
format = "<b>%s</b>\n<span size='smaller'>%b</span>"
alignment = left
vertical_alignment = center
ellipsize = middle
word_wrap = yes

### Icons ###
icon_position = left
min_icon_size = 32
max_icon_size = 48
icon_theme = Papirus-Dark, Adwaita

### Behavior ###
sort = yes
stack_duplicates = true
hide_duplicate_count = false
show_age_threshold = 60
idle_threshold = 120
sticky_history = yes
history_length = 20

### Progress Bar ###
progress_bar = true
progress_bar_height = 6
progress_bar_frame_width = 0
progress_bar_min_width = 120
progress_bar_max_width = 300
progress_bar_corner_radius = 6

### Mouse Actions ###
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

### Misc ###
browser = xdg-open
dmenu = fuzzel --dmenu
always_run_script = true

# Catppuccin Mocha Palette
# Base:     #1e1e2e
# Surface0: #313244
# Text:     #cdd6f4
# Blue:     #89b4fa
# Green:    #a6e3a1
# Yellow:   #f9e2af
# Red:      #f38ba8
# Peach:    #fab387

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#313244"
highlight = "#a6e3a1"
timeout = 4

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#89b4fa"
highlight = "#89b4fa"
timeout = 6

[urgency_critical]
background = "#1e1e2e"
foreground = "#f38ba8"
frame_color = "#f38ba8"
highlight = "#fab387"
timeout = 0
